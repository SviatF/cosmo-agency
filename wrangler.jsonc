{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cosmo-agency",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-18",
  "keep_vars": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
